  "keywords": [
    "genpage",
    "report",
    "visualization",
    "html",
    "dashboard",
    "chart",
    "mermaid",
    "daisyui",
    "tailwind",
    "ai-skill",
    "structured-output"
  ],
  "platforms": [
    "claude",
    "cursor",
    "windsurf",
    "copilot",
    "kiro",
    "roocode",
    "kilocode",
    "codex",
    "qoder",
    "gemini",
    "trae",
    "opencode",
    "continue",
    "codebuddy",
    "droid",
    "warp",
    "augment",
    "antigravity"
  ],
  "install": "claude plugin marketplace add nandzz/genpage"
}
